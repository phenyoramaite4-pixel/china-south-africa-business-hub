// Translation dictionary for the China–South Africa Business Hub.
//
// Architecture: each supported language is a flat-ish object of
// namespaced keys. Components call `t('namespace.key')` via the
// LanguageContext. Add a new language by adding a new top-level key
// here — no other code changes are required for existing strings,
// and any key missing in a translation simply falls back to English.

export const LANGUAGES = [
  { code: "en", label: "English" },
  { code: "zh", label: "中文" },
];

export const DEFAULT_LANGUAGE = "en";

